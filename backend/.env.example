# Base de données MySQL / MariaDB (WAMP)
# Mot de passe root vide : mysql+pymysql://root@127.0.0.1:3306/clinique_db?charset=utf8mb4
# Avec mot de passe : mysql+pymysql://root:mon_mdp@127.0.0.1:3306/clinique_db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/clinique_db?charset=utf8mb4

# Sécurité
SECRET_KEY=changez_cette_cle_minimum_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mobile Money
MTN_MOMO_API_KEY=
ORANGE_MONEY_API_KEY=
# Campay — https://www.campay.net/ (DEV: https://demo.campay.net)
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# Optionnel : si défini, utilisé comme Authorization sur POST /api/token/
CAMPAY_PERMANENT_ACCESS_TOKEN=
# Clé webhook : JWT HS256 (Authorization: Bearer …) OU en-tête x-webhook-token en clair
CAMPAY_WEBHOOK_SECRET=
# URLs après paiement sur la page Campay (lien QR) — optionnel
CAMPAY_PAYMENT_REDIRECT_URL=
CAMPAY_PAYMENT_FAILURE_REDIRECT_URL=
CAMPAY_ORANGE_OPERATOR_CODE=orange
CAMPAY_MTN_OPERATOR_CODE=mtn

# Connexion Google — infirmière d'accueil uniquement (optionnel)
# Créer un identifiant OAuth « Application Web » : https://console.cloud.google.com/
# Origines JavaScript autorisées : http://localhost:4200
# L'e-mail Google doit être identique à celui du compte en base (ex. infirmier@demo.cm)
GOOGLE_CLIENT_ID=
GOOGLE_ACCUEIL_AUTH_ENABLED=false

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
